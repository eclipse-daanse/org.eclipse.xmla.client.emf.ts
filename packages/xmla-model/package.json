{
  "name": "@eclipse-daanse/xmla-model",
  "version": "0.0.1-next.1",
  "type": "module",
  "license": "EPL-2.0",
  "description": "The XMLA Ecore models, bootstrapped into a live registry, plus the rowset catalogue over them.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "model"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "prepack": "tsc --build"
  },
  "dependencies": {
    "@eclipse-daanse/emf-xml": "0.0.1-next.1",
    "@emfts/core": "0.3.0-next.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  }
}

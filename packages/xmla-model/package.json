{
  "name": "@daanse/xmla-model",
  "version": "0.0.1",
  "type": "module",
  "license": "EPL-2.0",
  "description": "The XMLA Ecore models, bootstrapped into a live registry, plus the rowset catalogue over them.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "model"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@daanse/emf-xml": "0.0.1",
    "@emfts/core": "0.1.1-next.16"
  }
}

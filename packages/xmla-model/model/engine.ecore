      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A string that specifies the credentials to use for impersonation. The enumeration values are as follows:Default - The server uses the impersonation method that it deems to be appropriate for the context in which impersonation is used.ImpersonateServiceAccount - Use the user account that the server is running as.ImpersonateAnonymous - Use the anonymous user account.ImpersonateCurrentUser - Use the user account that the client is connecting as.ImpersonateAccount - Use the specified user account.&lt;124>"/>
      </eAnnotations>

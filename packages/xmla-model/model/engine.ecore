  <eClassifiers xsi:type="ecore:EClass" name="DimensionBinding" eSuperTypes="#//Binding">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The DimensionBinding complex type represents a binding to a dimension. &lt;xsd:complexType name=&quot;DimensionBinding&quot; > &lt;xsd:complexContent> &lt;xsd:extension base=&quot;Binding&quot;> &lt;xsd:all> &lt;xsd:element name=&quot;DataSourceID&quot; type=&quot;xsd:string&quot;/> &lt;xsd:element name=&quot;DimensionID&quot; type=&quot;xsd:string&quot;/> &lt;xsd:element name=&quot;Persistence&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base=&quot;xsd:string&quot; > &lt;xsd:enumeration value=&quot;NotPersisted&quot; /> &lt;xsd:enumeration value=&quot;Metadata&quot; /> &lt;/xsd:restriction> &lt;/xsd:simpleType> &lt;/xsd:element> &lt;xsd:element name=&quot;RefreshPolicy&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base= …"/>

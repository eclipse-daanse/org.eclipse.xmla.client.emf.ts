        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Determines how often the dynamic part of the dimension or measure group (as specified by the Persistence element) is checked for changes. Enumeration values are as follows:ByQuery - Every query checks to see whether the source data has changed.ByInterval - Source data is checked for changes only at the interval that is specified by the RefreshInterval element."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="RefreshPolicy"/>

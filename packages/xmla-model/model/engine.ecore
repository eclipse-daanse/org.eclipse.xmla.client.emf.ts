  <eClassifiers xsi:type="ecore:EClass" name="CubeAttribute">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The CubeAttribute complex type defines details for an attribute on a cube. &lt;xsd:complexType name=&quot;CubeAttribute&quot;> &lt;xsd:all> &lt;xsd:element name=&quot;AttributeID&quot; type=&quot;xsd:string&quot;/> &lt;xsd:element name=&quot;AggregationUsage&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base=&quot;xsd:string&quot;> &lt;xsd:enumeration value=&quot;Full&quot; /> &lt;xsd:enumeration value=&quot;None&quot; /> &lt;xsd:enumeration value=&quot;Unrestricted&quot; /> &lt;xsd:enumeration value=&quot;Default&quot; /> &lt;/xsd:restriction> &lt;/xsd:simpleType> &lt;/xsd:element> &lt;xsd:element name=&quot;AttributeHierarchyOptimizedState&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base=&quot;xsd:string&quot;> &lt;xs …"/>
    </eAnnotations>

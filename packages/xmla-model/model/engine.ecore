      <details key="documentation" value="The DimensionPermission complex type represents permissions for a Dimension. &lt;xsd:complexType name=&quot;DimensionPermission&quot;> &lt;xsd:complexContent> &lt;xsd:extension base=&quot;Permission&quot;> &lt;xsd:sequence> &lt;!--Extended elements for DimensionPermission object--> &lt;xsd:element name=&quot;AttributePermissions&quot; minOccurs=&quot;0&quot;> &lt;xsd:complexType> &lt;xsd:sequence> &lt;xsd:element name=&quot;AttributePermission&quot; type=&quot;AttributePermission&quot; minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;/> &lt;/xsd:sequence> &lt;/xsd:complexType> &lt;/xsd:element> &lt;xsd:element name=&quot;Write&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base=&quot;xsd:string&quot; > &lt;xsd:enumerat …"/>

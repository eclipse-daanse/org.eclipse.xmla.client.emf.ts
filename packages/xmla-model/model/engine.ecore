  <eClassifiers xsi:type="ecore:EClass" name="ProactiveCaching">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The ProactiveCaching complex type represents proactive caching settings for an object. &lt;xsd:complexType name=&quot;ProactiveCaching&quot;> &lt;xsd:all> &lt;xsd:element name=&quot;OnlineMode&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base=&quot;xsd:string&quot;> &lt;xsd:enumeration value=&quot;Immediate&quot; /> &lt;xsd:enumeration value=&quot;OnCacheComplete&quot; /> &lt;/xsd:restriction> &lt;/xsd:simpleType> &lt;/xsd:element> &lt;xsd:element name=&quot;AggregationStorage&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base=&quot;xsd:string&quot;> &lt;xsd:enumeration value=&quot;Regular&quot; /> &lt;xsd:enumeration value=&quot;MolapOnly&quot; /> &lt;/xsd:restriction> &lt;/xsd:simpleType> &lt;/xsd:elem …"/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="ProactiveCaching"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="onlineMode" eType="#//OnlineModeEnum"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A string that specifies whether the dimension/partition is brought back online immediately when the rebuilding of the cache is initiated or only when the rebuilding of the cache is complete."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="OnlineMode"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="aggregationStorage" eType="#//AggregationStorageEnum"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A string that specifies the storage method for aggregations. Applies only to partitions. On a dimension, it MUST be &quot;Regular&quot;."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="AggregationStorage"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" eType="#//ProactiveCachingBinding"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The binding of the proactive caching. This regulates the notification mechanisms as well as the processing options."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="Source"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="silenceInterval" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The minimum amount of quiet time (in milliseconds) that occurs before the cache rebuild starts. The default value, -1 second, is used to specify an infinite interval."/>

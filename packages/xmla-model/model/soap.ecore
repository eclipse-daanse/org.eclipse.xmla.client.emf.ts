        <details key="kind" value="attribute"/>
        <details key="name" value="SessionId"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="VersionHeader" eSuperTypes="#//HeaderEntry">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A sequence number the client attaches to requests that open a conversation rather than continue one. Observed value 926 throughout one recorded connect, so it does not increment per request; what it counts is not documented anywhere this project has access to, and nothing here acts on it."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Version"/>
      <details key="kind" value="empty"/>
      <details key="namespace" value="http://schemas.microsoft.com/analysisservices/2003/engine/2"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sequence" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//LongObject">
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="Sequence"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="NamespaceCompatibilityHeader" eSuperTypes="#//HeaderEntry">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Sent empty. It asks the server to keep to namespaces an older client understands; there is nothing in it to read, and its presence is the whole message."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="NamespaceCompatibility"/>
      <details key="kind" value="empty"/>
      <details key="namespace" value="http://schemas.microsoft.com/analysisservices/2003/xmla"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BeginGetSessionTokenHeader" eSuperTypes="#//HeaderEntry">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Asks the server for a session token before opening a session. The captured server ignores it: it answers the empty result and returns no token anywhere, and Excel carries on with an ordinary BeginSession. It is a negotiation a server may decline in silence."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="BeginGetSessionToken"/>
      <details key="kind" value="empty"/>
      <details key="namespace" value="http://schemas.microsoft.com/analysisservices/2003/xmla"/>
    </eAnnotations>
  </eClassifiers>

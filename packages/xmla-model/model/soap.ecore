  <eClassifiers xsi:type="ecore:EClass" name="HeaderEntry" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A SOAP header block. mustUnderstand lives here rather than on each subclass: SOAP 1.1 defines it for every header entry, and a receiver that does not understand an entry carrying mustUnderstand=&quot;1&quot; must raise a MustUnderstand fault."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="HeaderEntry"/>
      <details key="kind" value="empty"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mustUnderstand" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="mustUnderstand"/>
        <details key="namespace" value="http://schemas.xmlsoap.org/soap/envelope/"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="UnknownHeader" eSuperTypes="#//HeaderEntry">

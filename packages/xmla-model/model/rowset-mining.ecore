<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="mining" nsURI="urn:schemas-microsoft-com:xml-analysis:rowset:mining"
    nsPrefix="rsmin">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="The data mining schema rowsets, from OLE DB for Data Mining. XMLA 1.1 calls a server that serves these a DMP, a data mining provider, and treats it as a kind of its own beside tabular and multidimensional - a recorded Analysis Services server declares itself all three.&#xA;&#xA;The nsURI of this package was chosen by this project and is not specified by anyone. [MS-SSAS] and XMLA 1.1 give all rowsets one single namespace, urn:schemas-microsoft-com:xml-analysis:rowset, and a server states it once per response - one recorded session carries 19 inline schemas that all declare it. XSD allows many schema documents to share a target namespace; an EMF EPackage cannot, so more than one rowset package can never carry the specified value and every one of them needs an identifier of its own. This one is shaped like a Microsoft namespace so that the family stays visible, but Microsoft did not issue it. The specified namespace is where it belongs: on every feature, literally, and in XmlaNamespaces.ROWSET.&#xA;&#xA;Generated by spec/split_rowset_packages.py.&#xA;&#xA;The Restrictions classes here are the deliberate exception to everything above. They are API objects for clients and connectors and are never serialized - nothing writes a Restrictions object to a wire. Their features therefore resolve ##targetNamespace to this package, which means nothing, and the test that every rowset column names the rowset namespace skips them for that reason. Their feature order is the order the RestrictionsMask bitmask is defined over, and a restriction's name on the wire is its ExtendedMetaData name.&#xA;&#xA;They are in this package rather than beside it so that a rowset and what may restrict it cannot be loaded apart: they were separate once, half of them was staged in a test, and the server answered that a restriction it models was not recognized."/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.xmla.model.rowset"/>
    <details key="prefix" value="RowsetMining"/>
    <details key="fileExtensions" value="xmlarsrsmin"/>
    <details key="resource" value="XML"/>
    <details key="literalsInterface" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="DmschemaMiningColumnsRow">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The DMSCHEMA_MINING_COLUMNS rowset contains the following columns. First, the rowset is sorted by mining structure name, which is not a column in the rowset. Then, the rowset is sorted on MODEL_CATALOG, MODEL_SCHEMA, MODEL_NAME, and COLUMN_NAME."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="dmschema-mining-columns-row"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/xmla/rowset/1.0">
      <details key="requestType" value="DMSCHEMA_MINING_COLUMNS"/>
      <details key="source" value="MS-SSAS-251031"/>
      <details key="guid" value="3ADD8A78-D8B9-11D2-8D2A-00E029154FDE"/>
      <details key="guidSource" value="OBSERVED"/>
      <details key="observedFrom" value="Analysis Services, DISCOVER_SCHEMA_ROWSETS answer (recorded-ssas.xml); the same value in ADOMD.NET 19.114.12 AdomdSchemaGuid"/>
    </eAnnotations>

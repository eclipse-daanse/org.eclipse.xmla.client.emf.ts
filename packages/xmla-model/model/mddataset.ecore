  <eClassifiers xsi:type="ecore:EClass" name="CellProperty">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A property *value*, inside a Cell or a Member: &amp;lt;FmtValue>$29,358,677.22&amp;lt;/FmtValue>. The same element name as the declaration in CellInfo, but carrying a value rather than saying what the name means - and it may carry an Error instead, when the cell's calculation failed. The api models both shapes with one interface and overloads name() to mean the value here, which is why there are two classes on this side and one there."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="CellProperty"/>

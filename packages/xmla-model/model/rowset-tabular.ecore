  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="The tabular schema rowsets, from [MS-SSAS-T]. One EClass per TMSCHEMA_* rowset, spelled out in full, from that specification's column table and the XSD it embeds beside it.&#xA;&#xA;A separate package from the multidimensional rowsets because it describes a different thing: MDSCHEMA_* describes cubes, dimensions, hierarchies and levels; TMSCHEMA_* describes tables, columns, relationships and DAX measures. A server answers one family or the other, according to the mode it runs in.&#xA;&#xA;On the wire both families are the same namespace, urn:schemas-microsoft-com:xml-analysis:rowset. Two EPackages cannot share an nsURI, so this one has its own and every feature carries the wire namespace LITERALLY. Writing ##targetNamespace here would resolve against this package's nsURI instead, and a reader would then look for elements in a namespace no server ever writes - finding nothing, and saying nothing.&#xA;&#xA;Generated by spec/bootstrap_tabular_rowset_ecore.py - do not edit by hand."/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.xmla.model.rowset"/>
    <details key="prefix" value="RowsetTabular"/>
    <details key="fileExtensions" value="xmlarst"/>
    <details key="resource" value="XML"/>
    <details key="literalsInterface" value="true"/>
  </eAnnotations>

  <eClassifiers xsi:type="ecore:EDataType" name="XmlDocument" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Arbitrary XML carried as a value. An Alter or Create carries an ASSL object definition - a whole &lt;Cube> or &lt;Dimension> from one of the engine namespaces - and this project does not model those: it carries them faithfully and hands them to the service, which does. Typed as a string it was worse than unmodelled, because the reader called getElementText() and threw on the first element inside."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="xmlDocument"/>
      <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#anyType"/>
      <details key="processing" value="lax"/>
    </eAnnotations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="CommitTransaction" eSuperTypes="#//Command">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The CommitTransaction command commits a transaction on the current session. &lt;xsd:complexType name=&quot;CommitTransaction&quot;> &lt;xsd:all> &lt;xsd:element name=&quot;DurabilityGuarantee&quot; minOccurs=&quot;0&quot;> &lt;xsd:simpleType> &lt;xsd:restriction base=&quot;xsd:string&quot; > &lt;xsd:enumeration value=&quot;LocalDisk&quot; /> &lt;xsd:enumeration value=&quot;Full&quot; /> &lt;/xsd:restriction> &lt;/xsd:simpleType> &lt;/xsd:element> &lt;/xsd:all> &lt;/xsd:complexType> The return result type for the CommitTransaction command is xmla-e:emptyresult."/>

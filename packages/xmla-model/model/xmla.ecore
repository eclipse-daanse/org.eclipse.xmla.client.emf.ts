<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="xmla" nsURI="urn:schemas-microsoft-com:xml-analysis" nsPrefix="xmla">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="XML for Analysis (XMLA) protocol model. Covers Discover, Execute, Session, Properties, and Commands."/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.xmla.model"/>
    <details key="prefix" value="Xmla"/>
    <details key="fileExtensions" value="xmla"/>
    <details key="resource" value="XML"/>
    <details key="literalsInterface" value="true"/>
    <details key="copyrightText" value="Copyright (c) 2025 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="RequestTypeEnum">
    <eLiterals name="DBSCHEMA_CATALOGS" literal="DBSCHEMA_CATALOGS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the catalogs that are accessible on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DBSCHEMA_TABLES" value="1" literal="DBSCHEMA_TABLES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns dimensions, measure groups, or schema rowsets exposed as tables."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DBSCHEMA_COLUMNS" value="2" literal="DBSCHEMA_COLUMNS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns a row for each measure, each cube dimension attribute, and each schema rowset column, exposed as a column."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DBSCHEMA_PROVIDER_TYPES" value="3" literal="DBSCHEMA_PROVIDER_TYPES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset identifies the (base) data types supported by the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DBSCHEMA_SCHEMATA" value="4" literal="DBSCHEMA_SCHEMATA"/>
    <eLiterals name="DBSCHEMA_SOURCE_TABLES" value="5" literal="DBSCHEMA_SOURCE_TABLES"/>
    <eLiterals name="DBSCHEMA_TABLES_INFO" value="6" literal="DBSCHEMA_TABLES_INFO"/>
    <eLiterals name="MDSCHEMA_CUBES" value="7" literal="MDSCHEMA_CUBES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the structure of cubes within a database. Perspectives are also returned in this schema."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_DIMENSIONS" value="8" literal="MDSCHEMA_DIMENSIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the dimensions within a database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_HIERARCHIES" value="9" literal="MDSCHEMA_HIERARCHIES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes each hierarchy within a particular dimension."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_LEVELS" value="10" literal="MDSCHEMA_LEVELS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes each level within a particular hierarchy."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_MEASURES" value="11" literal="MDSCHEMA_MEASURES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes each measure."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_PROPERTIES" value="12" literal="MDSCHEMA_PROPERTIES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the properties of members and cell properties."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_MEMBERS" value="13" literal="MDSCHEMA_MEMBERS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the members within a database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_ACTIONS" value="14" literal="MDSCHEMA_ACTIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the actions that can be available to the client application."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_SETS" value="15" literal="MDSCHEMA_SETS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This Discover element describes any sets that are currently defined in a database, including session-scoped sets."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_KPIS" value="16" literal="MDSCHEMA_KPIS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the KPIs within a database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_MEASUREGROUPS" value="17" literal="MDSCHEMA_MEASUREGROUPS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the measure groups within a database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_MEASUREGROUP_DIMENSIONS" value="18" literal="MDSCHEMA_MEASUREGROUP_DIMENSIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset enumerates the dimensions of measure groups."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_FUNCTIONS" value="19" literal="MDSCHEMA_FUNCTIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The MDSCHEMA_FUNCTIONS schema rowset returns information about the functions that are currently available for use in the DAX and MDX languages."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MDSCHEMA_INPUT_DATASOURCES" value="20" literal="MDSCHEMA_INPUT_DATASOURCES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset request describes the data source objects defined within the database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_DATASOURCES" value="21" literal="DISCOVER_DATASOURCES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns a list of the data sources that are available on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_PROPERTIES" value="22" literal="DISCOVER_PROPERTIES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns a list of information and values about the properties that are supported by the server for the specified data source."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_LITERALS" value="23" literal="DISCOVER_LITERALS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns information about literals supported by the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_SCHEMA_ROWSETS" value="24" literal="DISCOVER_SCHEMA_ROWSETS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns the names, restrictions, description, and other information for all Discover requests."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_KEYWORDS" value="25" literal="DISCOVER_KEYWORDS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns information about keywords that are reserved by the XMLA server. If you call the Discover method with the DISCOVER_KEYWORDS enumeration value in the RequestType element, the Discover method returns the DISCOVER_KEYWORDS rowset."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_ENUMERATORS" value="26" literal="DISCOVER_ENUMERATORS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns a list of names, data types, and enumeration values of enumerators supported by the XMLA Provider for a specific data source."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_INSTANCES" value="27" literal="DISCOVER_INSTANCES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset describes the instances on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_XML_METADATA" value="28" literal="DISCOVER_XML_METADATA">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns a rowset with one row and one column. The single cell in the rowset contains an XML document that contains the requested XML metadata."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_CSDL_METADATA" value="29" literal="DISCOVER_CSDL_METADATA">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_CSDL_METADATA&lt;355> schema rowset returns information about database metadata for in-memory databases. When the Perspectives restriction is included in DISCOVER_CSDL_METADATA, the output, which is the XML documented in [MS-CSDLBI], SHOULD&lt;356> include the objects that are not part of the perspectives in the XML output, and these objects SHOULD be marked as hidden."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_TRACES" value="30" literal="DISCOVER_TRACES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset contains the DISCOVER_TRACES schema rowset."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_TRACE_DEFINITION_PROVIDERINFO" value="31" literal="DISCOVER_TRACE_DEFINITION_PROVIDERINFO">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns basic information about the trace provider, such as its name and description."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_TRACE_COLUMNS" value="32" literal="DISCOVER_TRACE_COLUMNS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset contains the DISCOVER_TRACE_COLUMNS schema rowset."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_TRACE_EVENT_CATEGORIES" value="33" literal="DISCOVER_TRACE_EVENT_CATEGORIES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset contains the DISCOVER_TRACE_EVENT_CATEGORIES schema rowset."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_MEMORYUSAGE" value="34" literal="DISCOVER_MEMORYUSAGE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns the DISCOVER_MEMORYUSAGE statistics for various objects allocated by the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_MEMORYGRANT" value="35" literal="DISCOVER_MEMORYGRANT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This rowset returns a list of internal memory quota grants that are taken by jobs that are currently running on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_LOCKS" value="36" literal="DISCOVER_LOCKS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides information about the current standing locks on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_CONNECTIONS" value="37" literal="DISCOVER_CONNECTIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides resource usage and activity information about the currently opened connections on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_SESSIONS" value="38" literal="DISCOVER_SESSIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides resource usage and activity information about the currently opened sessions on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_JOBS" value="39" literal="DISCOVER_JOBS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides information about the active jobs executing on the server. A job is a part of a command that executes a specific task on behalf of the command."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_TRANSACTIONS" value="40" literal="DISCOVER_TRANSACTIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns the current set of pending transactions on the system."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_DB_CONNECTIONS" value="41" literal="DISCOVER_DB_CONNECTIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides resource usage and activity information about the currently opened connections from the server to a database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_MASTER_KEY" value="42" literal="DISCOVER_MASTER_KEY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns the server's master encryption key (the key that is used by the server to encrypt sensitive data on disk)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_PERFORMANCE_COUNTERS" value="43" literal="DISCOVER_PERFORMANCE_COUNTERS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns the value of one or more specified performance counters. It does not support counters that return information about usage over time (such as disk reads per second and percentage of CPU usage)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_LOCATIONS" value="44" literal="DISCOVER_LOCATIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This element returns information about the contents of a backup file. The user issuing the request MUST have access to the backup file location."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_COMMANDS" value="45" literal="DISCOVER_COMMANDS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides resource usage and activity information about the currently executing or last executed commands in the opened connections on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_COMMAND_OBJECTS" value="46" literal="DISCOVER_COMMAND_OBJECTS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides resource usage and activity information about the objects in use by the referenced command."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_OBJECT_ACTIVITY" value="47" literal="DISCOVER_OBJECT_ACTIVITY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides resource usage per object since the start of the service."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_OBJECT_MEMORY_USAGE" value="48" literal="DISCOVER_OBJECT_MEMORY_USAGE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset provides information about memory resources used by objects."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_STORAGE_TABLES" value="49" literal="DISCOVER_STORAGE_TABLES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns statistics about in-memory tables available to the server.&lt;332>"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_STORAGE_TABLE_COLUMNS" value="50" literal="DISCOVER_STORAGE_TABLE_COLUMNS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset contains information about the columns used for representing the columns of an in-memory table.&lt;337>"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_STORAGE_TABLE_COLUMN_SEGMENTS" value="51" literal="DISCOVER_STORAGE_TABLE_COLUMN_SEGMENTS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_STORAGE_TABLE_COLUMN_SEGMENTS schema rowset returns information about the column segments used for storing data for in-memory tables.&lt;347>"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_PARTITION_DIMENSION_STAT" value="52" literal="DISCOVER_PARTITION_DIMENSION_STAT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns statistics on the dimension that is associated with a partition."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_PARTITION_STAT" value="53" literal="DISCOVER_PARTITION_STAT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns statistics on aggregations in a particular partition."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_DIMENSION_STAT" value="54" literal="DISCOVER_DIMENSION_STAT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset returns statistics on the specified dimension."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_CALC_DEPENDENCY" value="55" literal="DISCOVER_CALC_DEPENDENCY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_CALC_DEPENDENCY&lt;360> schema rowset returns information about the calculation dependency for an object that is specified in a Tabular database or in a DAX query that is executed against a Tabular database. For more information about Tabular databases at compatibility levels equal to or greater than 1200, see [MS-SSAS-T]."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_RING_BUFFERS" value="56" literal="DISCOVER_RING_BUFFERS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_RING_BUFFERS schema rowset SHOULD&lt;367> return information about the current XEvent ring buffers on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_XEVENT_TRACE_DEFINITION" value="57" literal="DISCOVER_XEVENT_TRACE_DEFINITION">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_XEVENT_TRACE_DEFINITION schema rowset SHOULD&lt;368> provide information about the XEvent traces that are currently active on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_XEVENT_PACKAGES" value="58" literal="DISCOVER_XEVENT_PACKAGES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_XEVENT_PACKAGES schema rowset SHOULD&lt;369> provide information about the XEvent packages that are defined on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_XEVENT_OBJECTS" value="59" literal="DISCOVER_XEVENT_OBJECTS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_XEVENT_OBJECTS schema rowset SHOULD&lt;370> provide information about the XEvent objects that are defined on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_XEVENT_OBJECT_COLUMNS" value="60" literal="DISCOVER_XEVENT_OBJECT_COLUMNS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_XEVENT_OBJECT_COLUMNS schema rowset SHOULD&lt;371> provide information about the schema of XEvent objects that are defined on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_XEVENT_SESSIONS" value="61" literal="DISCOVER_XEVENT_SESSIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_XEVENT_SESSIONS schema rowset SHOULD&lt;372> provide information about the current XEvent sessions on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_XEVENT_SESSION_TARGETS" value="62" literal="DISCOVER_XEVENT_SESSION_TARGETS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_XEVENT_SESSION_TARGETS schema rowset SHOULD&lt;373> provide information about the current XEvent session targets on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_MEM_STATS" value="63" literal="DISCOVER_MEM_STATS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_MEM_STATS schema rowset SHOULD&lt;374> provide fine-grained information about all the memory trackers that are active on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_DB_MEM_STATS" value="64" literal="DISCOVER_DB_MEM_STATS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_DB_MEM_STATS schema rowset SHOULD&lt;377> provide coarse-grained information about the memory trackers that are active on the server. The data is aggregated at the database and system level."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCOVER_OBJECT_COUNTERS" value="65" literal="DISCOVER_OBJECT_COUNTERS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DISCOVER_OBJECT_COUNTERS schema rowset SHOULD&lt;379> return coarse-grained information about the number of in-memory objects of the specified class that are cached in engine memory. This rowset is intended for diagnostic investigations only."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DMSCHEMA_MINING_SERVICES" value="66" literal="DMSCHEMA_MINING_SERVICES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset MAY&lt;266> provide information about each data mining algorithm that the server supports."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DMSCHEMA_MINING_SERVICE_PARAMETERS" value="67" literal="DMSCHEMA_MINING_SERVICE_PARAMETERS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset MAY&lt;271> provide a list of parameters that can be used to configure the behavior of each data mining algorithm that is installed on the server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DMSCHEMA_MINING_FUNCTIONS" value="68" literal="DMSCHEMA_MINING_FUNCTIONS">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This schema rowset MAY&lt;272> describe the data mining functions that are supported by the data mining algorithms that are available on a server that is running Analysis Services."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DMSCHEMA_MINING_MODEL_CONTENT" value="69" literal="DMSCHEMA_MINING_MODEL_CONTENT">

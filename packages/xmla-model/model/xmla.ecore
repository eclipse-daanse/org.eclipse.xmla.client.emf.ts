  <eClassifiers xsi:type="ecore:EClass" name="Command" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The command an Execute request carries: one of thirty-three, from a bare MDX Statement to Alter, Create, Batch and Restore. Abstract, because the wire names the alternative rather than the base. Note that xmla.xsd uses the name Command for a second, unrelated type as well - the Text-and-Annotations command of an MdxScript, which this model calls MdxScriptCommand. Reading the two as one is what left MdxScript.commands untyped for as long as it was."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Command"/>
      <details key="kind" value="empty"/>

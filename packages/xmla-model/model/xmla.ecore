  <eClassifiers xsi:type="ecore:EClass" name="RowsetResult">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An Execute result of type xmla-rs:rowset ([MS-SSAS] 3.1.4.3.2.2.1): tabular rows with dynamic columns, as a DMV query, a drill-through, a SQL statement or Format=Tabular produce them. A carrier, not a wire type - the codec renders the root, the optional inline schema and the rows by hand, which is why nothing here carries ExtendedMetaData."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schemaIncluded" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the inline xsd:schema is written, governed by the request's Content property - SchemaData (the default) and Schema include it, Data and None do not."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="columns" upperBound="-1"
        eType="#//RowsetColumn" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rows" upperBound="-1" eType="#//RowsetRow"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RowsetColumn">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One column of a RowsetResult: the original name (sql:field in the inline schema), the encoded element name, and the xsd type - null for a column whose type varies per row."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="field" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="xsdType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RowsetRow">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One row: cells in column order. An absent cell is a NULL - the element is simply not written, as [MS-SSAS] 2.2.4.1.3.1 has it."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cells" upperBound="-1"
        eType="#//RowsetCell" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RowsetCell">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One cell: the element name and either a value or, for a nested rowset, child cells - the nested row's content is written directly inside the column element, Restrictions-style. A repeated column is simply a repeated cell."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cells" upperBound="-1"
        eType="#//RowsetCell" containment="true"/>
  </eClassifiers>
</ecore:EPackage>

  <eClassifiers xsi:type="ecore:EClass" name="Cancel" eSuperTypes="#//Command">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The Cancel command cancels the currently running command on the specified connection. &lt;xsd:complexType name=&quot;Cancel&quot;> &lt;xsd:all> &lt;xsd:element name=&quot;ConnectionID&quot; type=&quot;xsd:integer&quot; minOccurs=&quot;0&quot; /> &lt;xsd:element name=&quot;SessionID&quot; type=&quot;xsd:string&quot; minOccurs=&quot;0&quot; /> &lt;xsd:element name=&quot;SPID&quot; type=&quot;xsd:integer&quot; minOccurs=&quot;0&quot; /> &lt;xsd:element name=&quot;CancelAssociated&quot; type=&quot;xsd:boolean&quot; minOccurs=&quot;0&quot; /> &lt;/xsd:all> &lt;/xsd:complexType> The return result type for the Cancel command is xmla-e:emptyresult."/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/xmla/1.0">
      <details key="groupElementName" value="Cancel"/>

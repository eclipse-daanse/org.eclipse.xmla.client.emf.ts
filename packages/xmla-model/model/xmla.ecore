  <eClassifiers xsi:type="ecore:EEnum" name="RestoreReadWriteModeEnum">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The values Restore/ReadWriteMode is restricted to by the schema. The model carried it as embedded XML, which accepted anything and checked nothing."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">

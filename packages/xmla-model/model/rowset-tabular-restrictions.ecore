<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="restrictions"
    nsURI="https://www.daanse.org/spec/xmla/rowset/tabular/restrictions/1.0" nsPrefix="rstr">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="What each tabular schema rowset may be restricted by, one class per rowset. As with the multidimensional restrictions these are API objects for clients and connectors, not wire elements: the feature order is the order the RestrictionsMask bitmask is defined over, the restriction name on the wire is the ExtendedMetaData name, and the type is the feature type.&#xA;&#xA;[MS-SSAS-T] states them in two places per rowset - the column table marks which columns are restrictions, and a section beside it names any further ones. Both are taken; a restriction that is not a column has no type there and is read as a string.&#xA;&#xA;The thirty-two older classes come from [MS-SSAS-T]; the sixteen newer ones follow the same shape and were added beside the rowsets they restrict. Worth knowing before building anything on them: a TOM client sends exactly one restriction, DatabaseName, and the same value for all forty-eight rowsets of its batch. Everything else here is an offer no observed client takes up."/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.xmla.model.rowset.tabular"/>
    <details key="prefix" value="RestrictionsTabular"/>
    <details key="fileExtensions" value="xmlarstr"/>
    <details key="resource" value="XML"/>
    <details key="literalsInterface" value="true"/>
  </eAnnotations>

<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="core" nsURI="urn:schemas-microsoft-com:xml-analysis:rowset:core"
    nsPrefix="rscore">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="The datatypes every rowset package needs, in one place.&#xA;&#xA;XMLA rowsets are described by five packages, split by who can answer them rather than by what they are about: this one, holding the six XMLA 1.1 defines itself and every provider must serve; the OLE DB relational family; the multidimensional one; data mining; and the server's own internals. Each of them has columns typed uuid, dateTime or an embedded XML document, and before this package existed each declared its own: DateTime was written out once per package.&#xA;&#xA;They are declared once here and referenced by nsURI. Nothing that holds them is an EClass, so a datatype cannot appear on the wire by itself, which is what makes moving them a change to the models and not to the protocol.&#xA;&#xA;model/io reads the Uuid pattern from here rather than repeating it, so the inline schema it writes and this model cannot disagree about what a GUID looks like. It names all five packages; it used to name none and find them, which EMF's global registry turned out not to support.&#xA;&#xA;The Restrictions classes here are the deliberate exception to everything above. They are API objects for clients and connectors and are never serialized - nothing writes a Restrictions object to a wire. Their features therefore resolve ##targetNamespace to this package, which means nothing, and the test that every rowset column names the rowset namespace skips them for that reason. Their feature order is the order the RestrictionsMask bitmask is defined over, and a restriction's name on the wire is its ExtendedMetaData name.&#xA;&#xA;They are in this package rather than beside it so that a rowset and what may restrict it cannot be loaded apart: they were separate once, half of them was staged in a test, and the server answered that a restriction it models was not recognized."/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.xmla.model.rowset"/>
    <details key="prefix" value="RowsetCore"/>
    <details key="fileExtensions" value="xmlarscore"/>
    <details key="resource" value="XML"/>
    <details key="literalsInterface" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EDataType" name="Uuid" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A GUID as XMLA writes them, which is a string of a fixed shape rather than a type of its own. The pattern is stated here and nowhere else: RowsetSchemaWriter reads it from this annotation when it writes the inline schema, so the advertised schema and the model cannot disagree about what a GUID looks like."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="uuid"/>
      <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
      <details key="pattern" value="[0-9a-zA-Z]{8}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{12}"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="XmlDocument" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A column whose value is itself an XML document - the mining model content and the CSDL and XML metadata rowsets carry them. It is held as the text it arrived as, because parsing it would be this model claiming to know a schema it does not have."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="xmlDocument"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="DateTime" instanceClassName="java.time.LocalDateTime">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A timestamp without a zone, as XMLA writes them. Not the XMLType dateTime, because that maps to a String here and would lose the fact that the value is a point in time."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="dateTime"/>
      <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#dateTime"/>
    </eAnnotations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="AccessEnum">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How a property may be used; OLE DB's three-valued access. DISCOVER_PROPERTIES reports it in PropertyAccessType.&#xA;&#xA;The names are the specification's; the numbers are not. Neither [MS-SSAS] nor XMLA 1.1 assigns a value to any of these literals - XMLA 1.1 p. 48 has each provider publish whatever numbers it uses through DISCOVER_ENUMERATORS. The values here are therefore this server's own, and a client is meant to read them rather than assume them. TreeOp is the one vocabulary where the numbers ARE specified, because there they are a bitmask."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Access"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/xmla/rowset/1.0">
      <details key="role" value="enumerator"/>
    </eAnnotations>
    <eLiterals name="Read" literal="Read"/>
    <eLiterals name="Write" value="1" literal="Write"/>
    <eLiterals name="ReadWrite" value="2" literal="ReadWrite"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="AuthenticationModeEnum">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How a client authenticates against a data source, as DISCOVER_DATASOURCES reports it. Unauthenticated needs no credentials, Authenticated needs user and password, Integrated leaves it to the transport - XMLA 1.1 names Microsoft Internet Information Services as the example.&#xA;&#xA;This is the whole of what XMLA 1.1 has to say about authentication: it removed in-band credentials in 1.1, deprecating UserName and Password, and left one column that announces what the transport will demand. [MS-SSAS] adds the Authenticate exchange on top of it.&#xA;&#xA;The names are the specification's; the numbers are this server's own - see AccessEnum."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="AuthenticationMode"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/xmla/rowset/1.0">
      <details key="role" value="enumerator"/>
    </eAnnotations>
    <eLiterals name="Unauthenticated" literal="Unauthenticated"/>
    <eLiterals name="Authenticated" value="1" literal="Authenticated"/>
    <eLiterals name="Integrated" value="2" literal="Integrated"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ProviderTypeEnum">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What kind of data a provider serves, as DISCOVER_DATASOURCES reports it. XMLA 1.1 defines all three and requires a different set of rowsets of each: TDP a tabular data provider, MDP a multidimensional one, DMP a data mining provider implementing OLE DB for Data Mining. A recorded Analysis Services server declares itself all three.&#xA;&#xA;The column is an array, not a single value, which is why one server can be all three at once. The names are the specification's; the numbers are this server's own - see AccessEnum."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="ProviderType"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/xmla/rowset/1.0">
      <details key="role" value="enumerator"/>
    </eAnnotations>
    <eLiterals name="TDP" literal="TDP"/>
    <eLiterals name="MDP" value="1" literal="MDP"/>
    <eLiterals name="DMP" value="2" literal="DMP"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="TreeOpEnum">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The tree operations MDSCHEMA_MEMBERS accepts as its TREE_OP restriction, under OLE DB's MDTREEOP_* names.&#xA;&#xA;The values are a BITMASK and are not ordinals: a client sends 0x0C to ask for the parent and the member itself. Two independent sources give the same six, and they were 0.5 here until both were read: [MS-SSAS] states them as hex against MDSCHEMA_MEMBERS.TREE_OP (0x01 children, 0x02 same level, 0x04 parent, 0x08 itself, 0x10 descendants, 0x20 ancestors), and XML for Analysis 1.1 p. 31 gives the same numbers in decimal together with the symbolic names, saying 'The TREE_OP restriction is a bitmask, so bitwise combinations of its values are valid.'&#xA;&#xA;DMSCHEMA_MINING_MODEL_CONTENT has the same idea under a different prefix: TREE_OPERATION takes DMTREEOP_* with exactly these values."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="TreeOp"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/xmla/rowset/1.0">
      <details key="role" value="enumerator"/>
    </eAnnotations>
    <eLiterals name="MDTREEOP_CHILDREN" value="1" literal="MDTREEOP_CHILDREN"/>
    <eLiterals name="MDTREEOP_SIBLINGS" value="2" literal="MDTREEOP_SIBLINGS"/>
    <eLiterals name="MDTREEOP_PARENT" value="4" literal="MDTREEOP_PARENT"/>
    <eLiterals name="MDTREEOP_SELF" value="8" literal="MDTREEOP_SELF"/>
    <eLiterals name="MDTREEOP_DESCENDANTS" value="16" literal="MDTREEOP_DESCENDANTS"/>
    <eLiterals name="MDTREEOP_ANCESTORS" value="32" literal="MDTREEOP_ANCESTORS"/>
  </eClassifiers>
</ecore:EPackage>

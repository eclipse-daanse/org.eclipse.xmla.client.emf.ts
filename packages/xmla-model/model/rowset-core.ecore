      <details key="requestType" value="DISCOVER_DATASOURCES"/>
      <details key="guid" value="06C03D41-F66D-49F3-B1B8-987F7AF4CF18"/>
      <details key="source" value="MS-SSAS-251031"/>
    </eAnnotations>

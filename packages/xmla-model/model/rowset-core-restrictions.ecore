    <eStructuralFeatures xsi:type="ecore:EAttribute" name="providerType" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This array specifies the types of data supported by the server. It can include one or more of the following types:MDP: multidimensional data provider.TDP: tabular data provider.DMP: data mining provider (implements the OLE for DB for Data Mining specification).&lt;311>"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">

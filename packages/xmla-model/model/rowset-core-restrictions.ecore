  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="What the six rowsets XMLA defines itself may be restricted by, one class per rowset. These are API objects for clients and connectors, not wire elements: the feature order is the order the RestrictionsMask bitmask is defined over, the restriction name on the wire is the ExtendedMetaData name, and the type is the feature type.&#xA;&#xA;Because nothing here is ever serialized, the nsURI is a daanse one rather than a Microsoft-shaped one, and the features stay on ##targetNamespace.&#xA;&#xA;Generated by spec/move_core_rowsets.py."/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.xmla.model.rowset.core"/>
    <details key="prefix" value="RestrictionsCore"/>
    <details key="fileExtensions" value="xmlarscorer"/>
    <details key="resource" value="XML"/>
    <details key="literalsInterface" value="true"/>
  </eAnnotations>

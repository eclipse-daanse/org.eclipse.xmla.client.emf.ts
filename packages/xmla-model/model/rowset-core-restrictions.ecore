        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A string that specifies what type of security mode the data source uses. Values can be one of the following:Unauthenticated: No user ID or password has to be sent.Authenticated: User ID and password MUST be included in the information required to connect to the data source.Integrated: The data source uses the underlying security to determine authorization.&lt;312>"/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="AuthenticationMode"/>

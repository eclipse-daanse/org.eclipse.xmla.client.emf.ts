    <eStructuralFeatures xsi:type="ecore:EAttribute" name="trainingComplexity" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//IntObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The length of time that training is expected to take is as follows:0 - DM_TRAINING_COMPLEXITY_LOW indicates that the running time is relatively short, and that it is proportional to input.1 - DM_TRAINING_COMPLEXITY_MEDIUM indicates that the running time might be long, but that it is generally proportional to input.2 - DM_TRAINING_COMPLEXITY_HIGH indicates that the running time is long and that it might grow exponentially in relationship to the number of training cases."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">

  <eClassifiers xsi:type="ecore:EClass" name="DmschemaMiningColumnsRow">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The DMSCHEMA_MINING_COLUMNS rowset contains the following columns. First, the rowset is sorted by mining structure name, which is not a column in the rowset. Then, the rowset is sorted on MODEL_CATALOG, MODEL_SCHEMA, MODEL_NAME, and COLUMN_NAME. The response has the following definition. &lt;xsd:element name=&quot;root&quot;> &lt;xsd:complexType> &lt;xsd:sequence minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;> &lt;xsd:element name=&quot;row&quot; type=&quot;row&quot; /> &lt;/xsd:sequence> &lt;/xsd:complexType> &lt;/xsd:element> &lt;xsd:simpleType name=&quot;uuid&quot;> &lt;xsd:restriction base=&quot;xsd:string&quot;> &lt;xsd:pattern value=&quot;[0-9a-zA-Z]{8}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4 …"/>
    </eAnnotations>

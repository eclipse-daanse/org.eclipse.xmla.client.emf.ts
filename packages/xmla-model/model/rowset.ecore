  <eClassifiers xsi:type="ecore:EClass" name="VariantValue">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A column whose type varies from row to row. DMSCHEMA_MINING_MODEL_CONTENT/NODE_DISTRIBUTION/ATTRIBUTE_VALUE is the only one in all 103 rowsets: it holds a category name on one row and a number on the next. SSAS declares it in the inline schema with no type at all - which in XSD is anyType - and tags each non-string value with xsi:type. Typing it as a string, as this model did, read the value correctly and wrote it back untagged, so a client could no longer tell 1.5 the number from &quot;1.5&quot; the label."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="VariantValue"/>
      <details key="kind" value="simple"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//String">
